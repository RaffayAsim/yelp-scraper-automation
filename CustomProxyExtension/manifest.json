{
  "manifest_version": 3,
  "name": "Custom Latency-Based Proxy Manager",
  "version": "1.0.0",
  "description": "Automatically connects to the fastest configured proxy server on startup.",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
